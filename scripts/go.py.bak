CFLAGS    = "-Wno-unused-parameter -Wno-unused-variable -Os "
COMPILERS = ["clang-17"] #, "gcc-15"] # , "gcc-15", "clang-21" ]
OPTS      = []
OPT_FLAG  = "-Os"


BENCH_ITERS = 25
BENCH_SLEEP = 1#.25

ALWAYS_FAST_CLEAN = True
ROOT       = "/Users/davrod01/code/mbedtls/TF-PSA-Crypto"
BUILD_DIR  = f"{ROOT}/build"
OPTS_FILE  = f"{ROOT}/drivers/builtin/src/opts.h"
TEST_SUITES = [ "test_suite_aes.ctr", "test_suite_aes.ecb", "test_suite_gcm.aes128_de", "test_suite_gcm.aes128_en" ]
LOG        = f"{BUILD_DIR}/scripts/log.json"
CRYPTO_CONFIG_FILE = f"{ROOT}/include/psa/crypto_config.h"


TEMP_COMMIT_MSG = "temp commit for benchmarking"

SHOW_RAW_BUILD = False
SHOW_RAW_BENCH = False
SHOW_RAW_TEST  = False

BENCHMARKS = ["aes_ctr", "ctr_drbg", "aes_gcm"]

def gen_opt_combos():
    if args.gcc:
        compilers = ["gcc-15"]
    else:
        compilers = COMPILERS
    if args.X:
        opts = []
        if not args.no_aesce:
            opts += [ "MBEDTLS_AESCE_C" ]
        if not args.only_128:
            opts += [ "MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH" ]
        compilers = [ "clang-17", "gcc-15" ]
    else:
        opts = []
    opts += OPTS

    cs = set(itertools.combinations((True, False) * len(opts), len(opts)))
    def_opts = [list(zip(opts, c)) for c in sorted(cs)]

    opts = []
    for cc in compilers:
        for do in def_opts:
            opts.append({"cc": cc, "options": do})
    if not args.X:
        for o in opts:
            o["options"] += [
            ("MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH", args.only_128),
            ("MBEDTLS_AESCE_C", not args.no_aesce),
            ("PSA_WANT_ALG_GCM", args.gcm),
            ("MBEDTLS_BLOCK_CIPHER_NO_DECRYPT", True)
        ]
    else:
        for o in opts:
            if args.gcm:
                o["options"] = [t for t in o["options"] if t[0] != "PSA_WANT_ALG_GCM"]
                o["options"] += [("PSA_WANT_ALG_GCM", True)]
            if args.only_128:
                o["options"] = [t for t in o["options"] if t[0] != "MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH"]
                o["options"] += [("MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH", True)]


    for o in opts:
        if not any(x[0] == "MBEDTLS_AESCE_C" for x in o["options"]):
            o["options"].append(("MBEDTLS_AESCE_C", False))
        if not any(x[0] == "PSA_WANT_ALG_GCM" for x in o["options"]):
            o["options"].append(("PSA_WANT_ALG_GCM", False))
        if not any(x[0] == "MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH" for x in o["options"]):
            o["options"].append(("MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH", False))

        if not any(x[0] == "MBEDTLS_AES_USE_HARDWARE_ONLY" for x in o["options"]):
            if ("MBEDTLS_AESCE_C", True) in o["options"]:
                o["options"].append(("MBEDTLS_AES_USE_HARDWARE_ONLY", True))
            else:
                o["options"].append(("MBEDTLS_AES_USE_HARDWARE_ONLY", False))

    # remove dupes, make into a dict
    for c in opts:
        c["options"] = {t[0]: t[1] for t in c["options"]}

    return opts


def update_file(fn, content):
    with open(fn) as f:
        content_current = f.read()
    if content != content_current:
        with(open(fn, "w")) as f:
             f.write(content)


def write_opts(l):
    s = "#ifndef OPTS_H\n#define OPTS_H\n\n"
    # #ifndef MBEDTLS_AESCE_C\n#define MBEDTLS_AESCE_C 1\n#endif\n\n"
    for o, e in l["options"].items():
        if o.startswith("MBEDTLS_"): continue
        if e:
            s += f"#define OPT_{o} 1\n"
        else:
            s += f"#undef OPT_{o}\n"
    s += "#endif"
    update_file(OPTS_FILE, s)
    

def set_config(c, e):
    with open(CRYPTO_CONFIG_FILE) as f:
        ls = f.readlines()
    for i, l in enumerate(ls):
        if '#define' in l and c in l:
            if e and l.startswith('//'):
                ls[i] = l[2:]
            elif (not e) and (not l.startswith('//')):
                ls[i] = '//' + l
    content = "".join(ls)
    update_file(CRYPTO_CONFIG_FILE, content)


def run(cmd: str, env={}, fatal=True, dir=None, verbose=False) -> tuple[int, str]:
    e = {}
    e.update(os.environ)
    e.update(env)
    result = subprocess.run(
        cmd,
        shell=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        env=e,
        cwd=dir
    )
    if verbose or (result.returncode != 0 and fatal):
        print(cmd)
        print(result.stdout)
        print(f"returncode: {result.returncode}")
        if result.returncode != 0 and fatal:
            exit(result.returncode)
    return result.returncode, result.stdout


def cmake(cc):
    bdir = f"{BUILD_DIR}/{cc.split("/")[-1]}"
    if cc == "clang-17":
        cc = "/usr/bin/clang"
    elif cc == "gcc-15":
        cc = "/opt/homebrew/bin/gcc-15"
    elif cc == "clang-21":
        cc = "/opt/homebrew/opt/llvm/bin//clang-21"
    else:
        assert(False)
    cflags = f"{OPT_FLAG} {CFLAGS}"
    try:
        shutil.rmtree(bdir, ignore_errors=True)
    except:
        pass
    ccflags = \
        f"-DCMAKE_C_COMPILER={cc} " \
        f"-DCMAKE_CXX_COMPILER={cc} "     \
        f"-DCMAKE_C_FLAGS=\"{cflags}\" "

    cmd = f"cmake -S {ROOT} -B {bdir} {ccflags}"
    run(cmd, env={"CFLAGS": CFLAGS}, verbose=SHOW_RAW_BUILD)


def current_cc():
    try:
        assert(False)
        with open(f"{BUILD_DIR}/{cc}/CMakeCache.txt") as f:
            ls = f.readlines()
        for l in ls:
            if l.startswith("CMAKE_C_COMPILER:STRING"):
                cc = l.split("/")[-1].strip()
                if cc == "clang": cc = "clang-17"
                return cc
    except:
        return None


def build(config):
    tests = [
        ""
    ]
    #os.makedirs(f"{BUILD_DIR}/{config["cc"]}/programs/test", exist_ok=True)
    #os.makedirs(f"{BUILD_DIR}/{config["cc"]}/core", exist_ok=True)
    #os.makedirs(f"{BUILD_DIR}/{config["cc"]}/tests", exist_ok=True)
    os.makedirs(f"{BUILD_DIR}/{config["cc"]}", exist_ok=True)

    for o in config["options"]:
        if o.startswith("MBEDTLS_") or o.startswith("PSA_"):
            set_config(o, config["options"][o])
    write_opts(config)

    #if current_cc() != config["cc"]:
    #    clean = True

    if args.clean or args.cmake:
        if not args.quiet: print("clean")
        #run(f"make -C {BUILD_DIR}/{config["cc"]} clean", verbose=SHOW_RAW_BUILD)
        run(f"rm -rf {BUILD_DIR}/{config["cc"]}")
    else:
        if ALWAYS_FAST_CLEAN:
            for x in \
                ["tests/" + x for x in TEST_SUITES] + \
                ["tests/CMakeFiles/test_suite_aes.ctr.dir/test_suite_aes.ctr.c.o",
                 "drivers/builtin/CMakeFiles/builtin.dir/src/aesce.c.o",
                 "drivers/builtin/CMakeFiles/builtin.dir/src/aesce.c.o.d",
                 "drivers/builtin/CMakeFiles/builtin.dir/src/aes.c.o",
                 "programs/test/benchmark", "core/libtfpsacrypto.a"]:
                if os.path.exists(f"{BUILD_DIR}/{config["cc"]}/{x}"):
                    os.remove(f"{BUILD_DIR}/{config["cc"]}/{x}")

    cmakefile = f"{BUILD_DIR}/{config["cc"]}/CMakeCache.txt"
    if args.cmake or not os.path.exists(cmakefile):
        if not args.quiet: print("cmake")
        cmake(config["cc"])

    bench = args.bench
    test  = args.test
    if (not args.test) and args.bench and (not args.size):
        bench = True
        test = True
    if not args.bench:
        test = True
    bench=True

    if not args.quiet: print("make")
    #run(f"make -j20 -C {BUILD_DIR}/{config["cc"]} tests/{TEST_SUITE} programs/test/benchmark", verbose=SHOW_RAW_BUILD)
    if test:
        run(f"make -j -C {BUILD_DIR}/{config["cc"]}/tests {" ".join(TEST_SUITES)}", verbose=SHOW_RAW_BUILD)
    if bench:
        run(f"make -j -C {BUILD_DIR}/{config["cc"]}/programs/test benchmark", verbose=SHOW_RAW_BUILD)
    if args.size:
        #run(f"make -j10 -C {BUILD_DIR}/{config["cc"]}/drivers/builtin/CMakeFiles/builtin.dir src/aesce.c.o.d", verbose=SHOW_RAW_BUILD)
        run(f"make -j -C {BUILD_DIR}/{config["cc"]}/tests {TEST_SUITES[0]}", verbose=SHOW_RAW_BUILD)


def test():
    results = {}
    for s in TEST_SUITES:
        rc, output = run(f"{BUILD_DIR}/{config["cc"]}/tests/{s}", verbose=False)
        results[s] = {
            "output": output.splitlines()[-1] if rc == 0 else output,
            "rc": rc
        }
    return results


def get_size(quiet=True):
    _, output = run(f"size {BUILD_DIR}/{config["cc"]}/core/libtfpsacrypto.a")
    ls = output.strip().split("\n")[1:]
    #ls = [l.split("\t")[:2] + [l.split("\t")][-1] for l in ls if "aes" in l and not "aesni" in l]
    ls = [l.split("\t") for l in ls]
    ls = [l for l in ls if l[0] + l[1] != "00"]
    ls = sorted(ls, key=lambda t:int(t[0]) + int(t[1]))
    ls = [l[:-1] + [l[-1].split("(")[-1][:-3]] for l in ls]
    if not quiet:
        for x in ls:
            print("\t".join(x))
    
    size = {
    }
    sm = 0
    for l in ls:
        src = l[-1]
        st = int(l[0])
        sd = int(l[1])
        size[src] = { "text": st, "data": sd, "sum": st + sd }
        sm += st + sd
    size["total"] = sm
    size["aes"] = sum(size[x]["sum"] for x in size.keys() if "aes" in x)
    return size


def bench(config):
    hashes = get_hash()
    timestamp = datetime.datetime.now().isoformat()
    size = get_size(quiet=True)

    if args.test:
        if not args.quiet: print("test")
        test_result = test()
        for t, r in test_result.items():
            if r["rc"] == 0:
                #if not args.quiet: print(f"    {t}: ok")
                if SHOW_RAW_TEST:
                    print(r['output'])
            else:
                print(f"{t} FAILED\n{r['output']}\n")
    else:
        test_result = {"skipped": True, "suite": " ".join(TEST_SUITES), "returncode": None, "output": None}
    best_results = {}
    raw_results = {}
    if args.bench:
        if not args.quiet: print("bench")
        # TODO handle multiple algs better
        for i in range(0, BENCH_ITERS):
            if i > 0: time.sleep(BENCH_SLEEP)
            for bench in BENCHMARKS:
                cmd = f"{BUILD_DIR}/{config["cc"]}/programs/test/benchmark {bench}"
                rc, output = run(cmd, verbose=False, fatal=False)
                if SHOW_RAW_BENCH and i == (BENCH_ITERS - 1): print(output + "\n\n")
                #assert(rc == 0)
                br = {l.split(":")[0].strip(): float(l.split(":")[1].strip().split()[0]) / 1024 for l in output.split("\n") if "KiB/s" in l}
                for k, v in br.items():
                    raw_results.setdefault(k, []).append(v)
        for k in raw_results:
            best_results[k] = max(raw_results[k])
    result = {
        "size": size,
        "hash_tmp": hashes[0],
        "hash": hashes[1],
        "timestamp": timestamp,
        "test": test_result,
        "config": config,
        "raw_perf": raw_results,
        "best_perf": best_results
    }
    return result


def run_contains(search, cmd):
    rc, output = run(cmd)
    assert(rc == 0)
    return search in output

def get_hash():
    changed = [x for x in run("git status --porcelain")[1].splitlines() if not x.startswith("?? ")]
    changed = [x for x in changed if x.split()[-1] not in ["framework", "include/psa/crypto_config.h" ]]
    if not changed:
        hashes = (None, run("git log -1 --format=%h")[1].strip())
    else:
        run("git add -u .")
        run(f"git commit -m '{TEMP_COMMIT_MSG}'")
        hashes = run("git log -2 --format=%h")[1].split("\n")
        run("git reset --mixed HEAD~1")
    return hashes


def log_result(result):
    if os.path.exists(LOG):
        with open(LOG, "r") as f:
            j = json.loads(f.read())
    else:
        j = []
    j.append(result)
    with open(LOG, "w") as f:
        f.write(json.dumps(j, indent=4))


